{
  "name": "gladys-ovhcloud-dynhost",
  "version": "0.1.0",
  "private": true,
  "description": "External Gladys Assistant integration for OVHcloud DynHost (dynamic DNS): keeps DynHost names of an OVHcloud domain pointed at the public IPv4 / IPv6 address of the home through the official DynHost endpoint, with devices, scene triggers (public address changed, record updated, update failed), scene actions and a dashboard widget.",
  "homepage": "https://github.com/William-De71/gladys-ovhcloud-dynhost",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-ovhcloud-dynhost.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "ovhcloud",
    "dynhost",
    "dynamic-dns",
    "ddns",
    "home-automation"
  ]
}
